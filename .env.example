# Example environment variables for frontend-v2
# Copy this file to .env and fill in the values as needed

# Base URL for HTTP API (e.g., https://api.example.com)
API_BASE_URL=

# Base URL for WebSocket (origin only, e.g., wss://api.example.com)
# If not set, it will be derived from API_BASE_URL (http->ws, https->wss)
WS_BASE_URL=

# Force mock mode for live (true/false)
NEXT_PUBLIC_ENABLE_MOCKS=false

# Optional default camera id for live pages
NEXT_PUBLIC_DEFAULT_CAMERA_ID=
